{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22",
    "git@latest",
    "trivy@latest",
    "gitleaks@latest"
  ],
  "env": {
    "IMAGE_NAME": "ghcr.io/ika100/e2e-counter-service"
  },
  "shell": {
    "init_hook": [
      "npm install 2>/dev/null || true"
    ],
    "scripts": {
      "test": "node --test",
      "lint": "npx eslint . --max-warnings=0",
      "lint-fix": "npx eslint . --fix",
      "build": "npm run build",
      "security": "npm audit --audit-level=high && (command -v gitleaks > /dev/null 2>&1 && gitleaks detect --no-git --quiet || echo 'gitleaks not available, skipping secret scan')",
      "image-build": "docker build -t $IMAGE_NAME:local .",
      "image-scan": "trivy image --severity CRITICAL,HIGH --exit-code 1 $IMAGE_NAME:local"
    }
  }
}
